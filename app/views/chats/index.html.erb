<div class="chat-page">
  <h1>My Chat History</h1>

  <div class="row justify-content-center">
    <div class="col-sm-8 my-3">
      <%= form_with url: chats_path, method: :get, class: "d-flex" do %>
        <%= label_tag :query, "Search Chats" %>
        <%= text_field_tag :query,
              params[:query],
              class: "form-control",
              placeholder: "Type a keyword"
          %>
        <%= submit_tag "Search", name: "", class: "btn-freud " %>
      <% end %>
    </div>
  </div>


  <% if @chats.empty? %>
    <p>You have no chats yet.</p>
    <%= link_to "Start a new conversation →", root_path, class: "btn-freud start-button" %>
  <% else %>
    <ul>
      <% @chats.each do |chat| %>
        <li>
          <%= link_to chat.title, chat_path(chat) %>
          <%= link_to "Delete", chat_path(chat),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this chat?" },
                class: "delete-chat" %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>

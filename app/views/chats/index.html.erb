<div class="chat-page">
<h1>My Chat History</h1>
<% if @chats.empty? %>
  <p>You have no chats yet. </p>
  <button type="button" class="btn-freud start-button" data-bs-toggle="modal" data-bs-target="#newChatModal">
      Start a new conversation →
  </button>
<% else %>
  <ul>
    <% @chats.each do |chat| %>
    <li><%= link_to chat.title, chat_path(chat) %></li>
    <%= link_to "Delete", chat_path(chat),
      method: :delete,
      data: { confirm: "Are you sure you want to delete this chat?" },
      class: "btn btn-danger" %>
    <% end %>
  </ul>
<% end %>

  <%= link_to "Back to Home", root_path %>
</div>

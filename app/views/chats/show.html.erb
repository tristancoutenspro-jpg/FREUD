<div class="chat-page">
  <h1><%= @chat.title %></h1>

  <div class="messages">
    <% @messages.each do |message| %>
      <div class="message message-<%= message.role %>">
        <p>
          <strong><%= message.role == "user" ? "You" : @chat.therapist.name %>:</strong>
          <%= message.content %>
        </p>
      </div>
    <% end %>
  </div>

  <div class="message-form">
    <%= simple_form_for [@chat, Message.new] do |f| %>
      <%= f.input :content,
        label: false,
        placeholder: "Write your message..." %>

      <%= f.submit "Send" %>
    <% end %>
  </div>

 <%= link_to "Back to Home", root_path, class: "btn-freud" %>

</div>

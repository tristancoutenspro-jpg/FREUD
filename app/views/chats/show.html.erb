<div class="container my-5">
  <h1><%= @chat.title %></h1>
</div>

<div class="messages">
  <% @messages.each do |message| %>
    <div class="message">

      <p><%= message.content %></p>
    </div>
  <% end %>
</div>
<div class="message-form">
  <%= simple_form_for [@chat, Message.new] do |f| %>
    <%= f.input :content,
      label: false,
      placeholder: "Write your message..." %>

    <%= f.submit "Send" %>
  <% end %>
</div>

<%= link_to "Back to chats", chats_path %>
